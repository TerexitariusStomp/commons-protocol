{
  "compilerOptions": {
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": true,
    "baseUrl": ".",
    "allowJs": true,
    "target": "ES2020",
    "isolatedModules": true,
    "jsx": "preserve",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "esnext",
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "incremental": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@liteflow/react": [
        "./src/liteflow.tsx"
      ],
      "@liteflow/react/dist/useBatchPurchase": [
        "./src/liteflow-batch.ts"
      ],
      "@liteflow/core": [
        "./src/liteflow-core.ts"
      ],
      "@liteflow/core/dist/utils/transaction": [
        "./src/liteflow-tx.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "type.d.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}